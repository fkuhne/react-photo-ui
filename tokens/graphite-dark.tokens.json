{
  "$description": "Graphite, dark: PhotoMatch's record 0070",
  "color": {
    "$type": "color",
    "canvas": {
      "$value": "{palette.grey.11}",
      "$description": "Behind the photos"
    },
    "panel": {
      "$value": "{palette.grey.15}",
      "$description": "Panels, the bar below"
    },
    "caption": {
      "$value": "{palette.grey.16}",
      "$description": "A photo's caption"
    },
    "control": {
      "$value": "{palette.grey.19}",
      "$description": "Controls"
    },
    "field": {
      "$value": "{palette.grey.11}",
      "$description": "Fields"
    },
    "popover": {
      "$value": "{palette.grey.19}",
      "$description": "Popovers and menus"
    },
    "line": {
      "$value": "{palette.grey.22}",
      "$description": "Lines between panels"
    },
    "edge": {
      "$value": "{palette.grey.29}",
      "$description": "Controls' edges"
    },
    "pressed": {
      "$value": "{palette.grey.27}",
      "$description": "A choice pressed"
    },
    "chip": {
      "$value": "{palette.grey.23}",
      "$description": "Tags; a bar button pressed"
    },
    "text": {
      "$value": "{palette.grey.90}",
      "$description": "Text",
      "$extensions": {
        "org.photo-ui": {
          "contrastOn": [
            "color.canvas",
            "color.panel",
            "color.caption",
            "color.control",
            "color.field",
            "color.popover",
            "color.chip",
            "color.pressed"
          ],
          "least": 4.5
        }
      }
    },
    "text-quiet": {
      "$value": "{palette.grey.66}",
      "$description": "Quieter text",
      "$extensions": {
        "org.photo-ui": {
          "contrastOn": [
            "color.canvas",
            "color.panel",
            "color.caption",
            "color.control",
            "color.field",
            "color.popover"
          ],
          "least": 4.5
        }
      }
    },
    "accent": {
      "$value": "{palette.amber.67}",
      "$description": "The accent, filled: what's selected, pressed or the first choice"
    },
    "accent-text": {
      "$value": "{palette.amber.67}",
      "$description": "The accent as text",
      "$extensions": {
        "org.photo-ui": {
          "contrastOn": [
            "color.panel",
            "color.control",
            "color.popover",
            "color.caption"
          ],
          "least": 4.5
        }
      }
    },
    "on-accent": {
      "$value": "{palette.grey.11}",
      "$description": "Text on the accent",
      "$extensions": {
        "org.photo-ui": {
          "contrastOn": [
            "color.accent"
          ],
          "least": 4.5
        }
      }
    },
    "selected": {
      "$value": "{palette.amber.67-a18}",
      "$description": "Selected, softly"
    },
    "label": {
      "red": {
        "$value": "{palette.red.55}"
      },
      "yellow": {
        "$value": "{palette.yellow.75}"
      },
      "green": {
        "$value": "{palette.green.63}"
      },
      "blue": {
        "$value": "{palette.blue.63}"
      }
    },
    "backdrop": {
      "$value": "{palette.grey.5}",
      "$description": "Behind a photo in the photo view and Compare"
    },
    "on-photo": {
      "$value": "{palette.grey.100}",
      "$description": "Text and marks over a photo, on a scrim, the same in every theme"
    },
    "knob": {
      "$value": "{palette.grey.90}",
      "$description": "A switch's knob and a slider's thumb, light in every theme"
    },
    "scrim": {
      "$value": "{palette.black.72}",
      "$description": "Behind text over a photo"
    },
    "scrim-soft": {
      "$value": "{palette.black.45}",
      "$description": "Behind a button over a photo"
    },
    "error": {
      "$value": "{palette.red.70}",
      "$description": "What went wrong, as text",
      "$extensions": {
        "org.photo-ui": {
          "contrastOn": [
            "color.canvas",
            "color.panel",
            "color.caption",
            "color.popover"
          ],
          "least": 4.5
        }
      }
    }
  },
  "shadow": {
    "$type": "shadow",
    "popover": {
      "$value": {
        "color": "{palette.black.50}",
        "offsetX": {
          "value": 0,
          "unit": "px"
        },
        "offsetY": {
          "value": 8,
          "unit": "px"
        },
        "blur": {
          "value": 24,
          "unit": "px"
        },
        "spread": {
          "value": 0,
          "unit": "px"
        }
      }
    },
    "dialog": {
      "$value": {
        "color": "{palette.black.55}",
        "offsetX": {
          "value": 0,
          "unit": "px"
        },
        "offsetY": {
          "value": 16,
          "unit": "px"
        },
        "blur": {
          "value": 48,
          "unit": "px"
        },
        "spread": {
          "value": 0,
          "unit": "px"
        }
      }
    }
  }
}
