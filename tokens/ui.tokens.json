{
  "font": {
    "family": {
      "$type": "fontFamily",
      "$value": [
        "-apple-system",
        "BlinkMacSystemFont",
        "Segoe UI Variable Text",
        "Segoe UI",
        "system-ui",
        "sans-serif"
      ],
      "$description": "The system's own font: SF Pro on a Mac, Segoe UI Variable on Windows (PhotoMatch's record 0070)"
    },
    "size": {
      "$type": "dimension",
      "$extensions": {
        "org.photo-ui": {
          "scaled": true
        }
      },
      "$description": "Scaled in CSS by --pu-text-scale, Settings' text size, 1 until set",
      "caption": {
        "$value": {
          "value": 11,
          "unit": "px"
        },
        "$description": "Captions, quieter labels and section names"
      },
      "text": {
        "$value": {
          "value": 12,
          "unit": "px"
        },
        "$description": "Text and controls"
      },
      "title": {
        "$value": {
          "value": 13,
          "unit": "px"
        },
        "$description": "A dialog's title"
      },
      "heading": {
        "$value": {
          "value": 15,
          "unit": "px"
        },
        "$description": "A panel's or a dialog's own heading"
      },
      "display": {
        "$value": {
          "value": 20,
          "unit": "px"
        },
        "$description": "A window's title, as the welcome's and About's"
      }
    },
    "line": {
      "$type": "dimension",
      "$extensions": {
        "org.photo-ui": {
          "scaled": true
        }
      },
      "caption": {
        "$value": {
          "value": 14,
          "unit": "px"
        }
      },
      "text": {
        "$value": {
          "value": 16,
          "unit": "px"
        }
      },
      "title": {
        "$value": {
          "value": 18,
          "unit": "px"
        }
      },
      "heading": {
        "$value": {
          "value": 20,
          "unit": "px"
        }
      },
      "display": {
        "$value": {
          "value": 28,
          "unit": "px"
        }
      }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": {
        "$value": 400
      },
      "strong": {
        "$value": 600
      }
    },
    "tracking": {
      "$type": "dimension",
      "label": {
        "$value": {
          "value": 0.66,
          "unit": "px"
        },
        "$description": "A section name's spacing, 0.06 of its 11 px, in small capitals"
      }
    }
  },
  "radius": {
    "$type": "dimension",
    "control": {
      "$value": {
        "value": 3,
        "unit": "px"
      },
      "$description": "Controls, photos and tags"
    },
    "popover": {
      "$value": {
        "value": 5,
        "unit": "px"
      },
      "$description": "Popovers and menus"
    },
    "dialog": {
      "$value": {
        "value": 6,
        "unit": "px"
      },
      "$description": "Dialogs"
    },
    "full": {
      "$value": {
        "value": 999,
        "unit": "px"
      },
      "$description": "Round: circles and pills"
    }
  },
  "space": {
    "$type": "dimension",
    "$description": "Steps of space, by their size in px",
    "2": {
      "$value": {
        "value": 2,
        "unit": "px"
      }
    },
    "4": {
      "$value": {
        "value": 4,
        "unit": "px"
      }
    },
    "6": {
      "$value": {
        "value": 6,
        "unit": "px"
      }
    },
    "8": {
      "$value": {
        "value": 8,
        "unit": "px"
      }
    },
    "10": {
      "$value": {
        "value": 10,
        "unit": "px"
      }
    },
    "12": {
      "$value": {
        "value": 12,
        "unit": "px"
      }
    },
    "16": {
      "$value": {
        "value": 16,
        "unit": "px"
      }
    },
    "20": {
      "$value": {
        "value": 20,
        "unit": "px"
      }
    },
    "24": {
      "$value": {
        "value": 24,
        "unit": "px"
      }
    },
    "32": {
      "$value": {
        "value": 32,
        "unit": "px"
      }
    }
  },
  "size": {
    "$type": "dimension",
    "control": {
      "$value": {
        "value": 24,
        "unit": "px"
      },
      "$description": "A control's height"
    },
    "control-large": {
      "$value": {
        "value": 26,
        "unit": "px"
      },
      "$description": "A control's height in a dialog's foot"
    },
    "menu-row": {
      "$value": {
        "value": 22,
        "unit": "px"
      }
    },
    "tree-row": {
      "$value": {
        "value": 24,
        "unit": "px"
      }
    },
    "bar": {
      "$value": {
        "value": 26,
        "unit": "px"
      },
      "$description": "The bar below the photos"
    }
  },
  "icon": {
    "$type": "dimension",
    "$extensions": {
      "org.photo-ui": {
        "scaled": true
      }
    },
    "$description": "An icon's size and line, scaled with the text",
    "size": {
      "$value": {
        "value": 14,
        "unit": "px"
      },
      "$description": "An icon beside text"
    },
    "stroke": {
      "$value": {
        "value": 1.4,
        "unit": "px"
      },
      "$description": "An icon's line, its width at any size, as in Graphite's mock-ups (PhotoMatch's record 0070)"
    }
  }
}
